# development | production (production refuses to start without JWT_SECRET)
ENVIRONMENT=development
# sqlite:///./database.db or postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///./database.db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# Comma-separated list of allowed origins, or *
CORS_ORIGINS=*
# Used by routers/brain_harness
GROQ_API_KEY=
